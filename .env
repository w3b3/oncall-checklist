# Optional build-time defaults. Everything here can also be set in the UI,
# which stores your choice in the browser instead of in the bundle.

# Repository the checklist opens on, as owner/repo.
REACT_APP_GITHUB_REPO=w-b-dev/oncall-checklist

# Branch your CI publishes to; its tip is used to detect the live commit.
REACT_APP_DEPLOY_BRANCH=gh-pages

# Read-only token. WARNING: anything set here is compiled into the public
# bundle. Leave it empty for public deployments and let each user add their
# own token in Settings.
REACT_APP_GITHUB_TOKEN=
